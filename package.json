{
  "name": "affixio-agent-relay",
  "version": "0.1.0",
  "description": "Zero-trust, cross-organisation agent-to-agent requests where every request carries a single-use AffixIO proof.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/unit/**/*.test.js\"",
    "test:live": "npm run build && node --test --test-reporter=spec --test-concurrency=1 \"dist/test/live/**/*.test.js\"",
    "example": "npm run build && node dist/examples/two-orgs.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "mcp",
    "agents",
    "agent-to-agent",
    "zero-trust",
    "affixio",
    "delegation",
    "quorum",
    "audit"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true,
  "type": "module",
  "types": "dist/src/index.d.ts",
  "bin": {
    "agent-relay": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AffixIO/affixio-agent-relay.git"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
